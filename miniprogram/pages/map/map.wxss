/* ========================================
   拾路派 - 地图页 — 所有 Token 由 variables.wxss 统一提供
   ======================================== */

.map-page {
  position: relative;
  height: 100vh;
  width: 100%;
  overflow: hidden;
}

.map {
  width: 100%;
  z-index: 1;
}

/* ========== 顶部标题栏（地图上覆盖） ========== */
.map-top-bar {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  z-index: 10;
  gap: 12rpx;
}

.map-location-card {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--color-surface);  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  box-shadow:
    0 2rpx 6rpx rgba(0,0,0,0.06),
    0 4rpx 14rpx rgba(0,0,0,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.8);
  flex-shrink: 1;
  min-width: 0;

  border: 1rpx solid var(--glass-border);}

.map-loc-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.map-loc-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-loc-arrow {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
}

.map-weather-card {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--color-surface);  border-radius: 24rpx;
  padding: 16rpx 18rpx;
  box-shadow:
    0 2rpx 6rpx rgba(0,0,0,0.06),
    0 4rpx 14rpx rgba(0,0,0,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.8);
  flex-shrink: 0;

  border: 1rpx solid var(--glass-border);}

.map-weather-icon {
  width: 28rpx;
  height: 28rpx;
}

.map-weather-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
  white-space: nowrap;
}

/* ========== 右侧控制按钮组 ========== */
.map-right-controls {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  background: var(--color-surface);  border-radius: 20rpx;
  overflow: hidden;
  box-shadow:
    0 2rpx 6rpx rgba(0,0,0,0.06),
    0 4rpx 14rpx rgba(0,0,0,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.7);
  z-index: 10;

  border: 1rpx solid var(--glass-border);}

.rctrl-btn {
  width: 80rpx;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.rctrl-icon {
  font-size: 30rpx;
  color: var(--color-text);
}

.rctrl-label {
  font-size: 18rpx;
  color: var(--color-muted);
  font-weight: 500;
  margin-top: 2rpx;
}

.rctrl-btn.rctrl-active {
  background: var(--color-primary);
}

.rctrl-btn.rctrl-active .rctrl-icon,
.rctrl-btn.rctrl-active .rctrl-label {
  color: var(--color-text-inverse);
}

.rctrl-divider {
  height: 1rpx;
  background: var(--color-surface-alt);
  margin: 0 16rpx;
}

/* ========== 加载遮罩 ========== */
.loading-overlay {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0,0,0,0.7);
  border-radius: 16rpx;
  padding: 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  z-index: 20;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255,255,255,0.2);
  border-top-color: var(--color-text-inverse);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 22rpx;
  color: var(--color-text-inverse);
}

/* ========== 底部面板 ========== */
.bottom-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-surface);
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  max-height: 55vh;
  min-height: 380rpx;
  overflow-y: auto;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  transition: max-height 0.35s ease, padding 0.35s ease, transform 0.35s ease;
  z-index: 30;
}

.bottom-panel.panel-dragging {
  transition: max-height 0s, padding 0s, transform 0s;
}

.bottom-panel.panel-collapsed {
  max-height: 380rpx;
  overflow: hidden;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.bottom-panel.panel-edit {
  max-height: 65vh;
}

.panel-handle {
  display: flex;
  justify-content: center;
  padding: 8rpx 0 20rpx;
}

.panel-handle-bar {
  width: 72rpx;
  height: 8rpx;
  background: var(--color-surface-alt);
  border-radius: 4rpx;
}

.panel-collapsed-preview {
  text-align: center;
  padding: 2rpx 0;
}

.collapsed-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-muted);
}

/* ========== 出行方式 Tab ========== */
.travel-mode-readonly { display: flex; align-items: center; gap: 10rpx; margin-bottom: 20rpx; padding: 16rpx 20rpx; color: var(--color-text); background: var(--color-surface-alt); border-radius: 16rpx; font-size: 24rpx; font-weight: 600; }.travel-mode-readonly .travel-tab-icon { width: 30rpx; height: 30rpx; }.travel-mode-hint { margin-left: auto; color: var(--color-text-muted); font-size: 20rpx; font-weight: 400; }
.travel-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 20rpx;
  padding: 8rpx;
}

.travel-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-muted);
  border-radius: 20rpx;
  position: relative;
}

.travel-tab.travel-active {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

.travel-tab-icon {
  width: 30rpx;
  height: 30rpx;
}

.travel-tab-label {
  font-size: 24rpx;
}

/* ========== 日期标题 ========== */
.panel-day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.panel-day-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-dark);
}

.day-dots {
  display: flex;
  gap: 12rpx;
}

.day-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-muted);
  background: var(--color-surface-alt);
  box-shadow:
    0 2rpx 4rpx rgba(0,0,0,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.6);
}

.day-dot.day-dot-active {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* ========== 途经点时间线 ========== */
.waypoint-timeline {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.wp-tl-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.wp-tl-dot.dot-start {
  background: #7B61FF;
}

.wp-tl-dot.dot-end {
  background: #FF6B6B;
}

.wp-tl-dot.dot-normal {
  background: #3B82F6;
}

.wp-tl-line {
  width: 3rpx;
  flex: 1;
  min-height: 40rpx;
  background: var(--color-surface-alt);
  border-radius: 2rpx;
  margin: 8rpx 0;
}

.wp-tl-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  padding-bottom: 20rpx;
  min-width: 0;
}

.wp-tl-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-dark);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wp-tl-time {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
  white-space: nowrap;
  flex-shrink: 0;
}

.wp-tl-desc {
  font-size: 22rpx;
  color: var(--color-placeholder);
  font-weight: 500;
}

.wp-tl-drag {
  display: flex;
  gap: 8rpx;
  align-items: center;
  flex-shrink: 0;
  padding-top: 16rpx;
}

.wp-drag-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  background: var(--color-surface-alt);
  color: var(--color-muted);
}

.wp-drag-btn.del {
  background: var(--color-danger-bg);
  color: var(--color-danger);
}

/* ========== 底部操作按钮 ========== */
.panel-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 8rpx;
}

.btn-add-waypoint {
  flex: 1;
  padding: 24rpx 0;
  background: var(--color-surface);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  box-shadow:
    0 2rpx 4rpx rgba(0,0,0,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.6);
}

.btn-add-waypoint::after {
  border: none;
}

.btn-optimize {
  flex: 1;
  padding: 24rpx 0;
  background: var(--color-brand);
  color: #FFFFFF;
  border: none;
  border-radius: 36rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-icon {
  width: 28rpx;
  height: 28rpx;
}

.btn-optimize::after {
  border: none;
}

/* ========== 弹窗 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 600rpx;
  background: var(--color-surface);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.15);

  border: 1rpx solid rgba(0,0,0,0.03);}

.modal-header {
  padding: 32rpx 32rpx 12rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-dark);
}

.modal-body {
  padding: 12rpx 32rpx 24rpx;
}

.modal-input {
  width: 100%;
  height: 84rpx;
  background: var(--color-surface-alt);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-muted);
  margin-bottom: 8rpx;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid var(--color-border);
}

.modal-btn {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border: none;
  background: transparent;
}

.modal-btn::after {
  border: none;
}

.modal-btn.cancel {
  color: var(--color-muted);
  border-right: 1rpx solid var(--color-border);
}

.modal-btn.confirm {
  color: var(--color-primary);
  font-weight: 700;
}

/* ======== 暗色主题（仅页面特有覆盖） ======== */
.theme-dark .bottom-panel,
.theme-dark .modal-content {
  background: var(--color-surface);
}

.theme-dark .map-location-card,
.theme-dark .map-weather-card,
.theme-dark .map-right-controls {
  background: var(--color-surface);
  border: var(--card-border);
}

.theme-dark .travel-tab {
  color: var(--color-text-muted);
}

.theme-dark .day-dot {
  background: #22252d;
  color: var(--color-text-muted);
}

.theme-dark .wp-tl-line {
  background: #2a2d35;
}

.theme-dark .wp-drag-btn {
  background: #22252d;
}

.theme-dark .btn-add-waypoint {
  background: #1a1d24;
}

.theme-dark .rctrl-label {
  color: var(--color-text-muted);
}

.theme-dark .rctrl-divider {
  background: #2a2d35;
}

.theme-dark .modal-btn.cancel {
  border-right-color: #2a2d35;
}

.theme-dark .modal-footer {
  border-top-color: #2a2d35;
}

.theme-dark .modal-input {
  background: #22252d;
  color: #E4E6EB;
}

.theme-dark .panel-handle {
  background: #2a2d35;
}
