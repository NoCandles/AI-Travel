/* 所有 Token 由 variables.wxss 统一提供 */
.page {
  padding: 0 var(--space-page-x);
  min-height: 100vh;
  background: var(--color-surface-alt);
  box-sizing: border-box;
}

/* ---- 深色模式页面背景（强制覆盖，规避跨页面 CSS 变量级联不可靠） ---- */
.theme-dark.page,
.page.theme-dark {
  background: #111318;
  color: var(--color-text);
}

/* ---- Header ---- */
.header {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 32rpx;
}
.header-left { flex: 1; }
.header-title {
  font-size: 64rpx; font-weight: 800; color: var(--color-dark);
  margin-bottom: 16rpx;
}
.header-indicator {
  width: 72rpx; height: 6rpx; background: var(--color-primary); border-radius: 4rpx;
}

/* ---- 卡片列表 ---- */
.fav-list { padding-bottom: 48rpx; }
.trip-card {
  display: flex; background: var(--color-card);
  border-radius: var(--radius-md); overflow: hidden; margin-bottom: 20rpx;
  box-shadow: var(--card-shadow);
}
.card-cover { width: 240rpx; height: 180rpx; flex-shrink: 0; }
.card-body {
  flex: 1; min-width: 0; padding: 16rpx 20rpx;
  display: flex; flex-direction: column; justify-content: space-between;
  overflow: hidden;
}
.card-title {
  display: block; font-size: 28rpx; font-weight: 700; color: var(--color-dark);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 100%;
}
.card-meta {
  display: flex; gap: 16rpx; align-items: center; margin-bottom: 8rpx;
  min-width: 0; overflow: hidden;
}
.card-location { font-size: 22rpx; color: var(--color-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.card-info {
  font-size: 20rpx; color: var(--color-primary); background: var(--color-brand-10);
  padding: 2rpx 12rpx; border-radius: 12rpx; font-weight: 600; flex-shrink: 0; white-space: nowrap;
}
.card-footer {
  display: flex; justify-content: space-between; align-items: center;
  min-width: 0; gap: 12rpx;
}
.card-user { display: flex; align-items: center; gap: 8rpx; min-width: 0; flex-shrink: 1; overflow: hidden; }
.card-avatar { width: 36rpx; height: 36rpx; border-radius: 50%; flex-shrink: 0; }
.card-nickname { font-size: 22rpx; color: var(--color-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-actions { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.card-count {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--color-danger);
  font-size: 22rpx;
  font-weight: 700;
}
.card-count-icon {
  width: 26rpx;
  height: 26rpx;
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 40rpx;
}
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 30rpx; font-weight: 700; color: var(--color-dark); margin-bottom: 12rpx; }
.empty-desc { font-size: 24rpx; color: var(--color-muted); text-align: center; }

/* ---- 暗色模式（仅页面特有覆盖） ---- */
.theme-dark .trip-card { border: var(--card-border); }
