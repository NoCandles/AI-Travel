/* ========================================
   发现界面 - 扁平简约风格
   ======================================== */

/* ---- 页面容器 ---- */
.page {
  padding: 0 var(--space-page-x);
  padding-bottom: 40rpx;
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
}

/* ---- Header ---- */
.header {
  padding: 28rpx 0 8rpx;
  width: 100%;
  box-sizing: border-box;
}

/* ---- 搜索框 ---- */

/* ---- 快捷筛选 ---- */


/* ---- 瀑布流 ---- */
.waterfall-wrap {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  width: 100%;
  align-items: flex-start;
}
.waterfall-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}
.trip-card {
  width: 100%;
  background: transparent;
  border-radius: 0;
  overflow: hidden;
  border: none;
  display: flex;
  flex-direction: column;
}
.trip-card:active {
  opacity: 0.85;
}

/* 封面图 */
.card-cover-wrap {
  position: relative;
  width: 100%;
}
.card-cover {
  width: 100%;
  display: block;
}
.card-days-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  z-index: 2;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  font-size: 18rpx;
  font-weight: 600;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1;
}

/* 卡片内容 */
.card-content {
  padding: 12rpx 14rpx 14rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.card-info {
  display: flex;
  flex-direction: column;
}
.card-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
}

/* 底部用户和点赞 */
.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-user {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  overflow: hidden;
}
.card-avatar-mini {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.card-username {
  font-size: 18rpx;
  color: var(--color-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.card-like {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.card-like-icon {
  width: 22rpx;
  height: 22rpx;
}
.card-like text {
  font-size: 18rpx;
  color: var(--color-text-muted);
}

/* ---- 空状态 ---- */
.empty-state {
  text-align: center;
  padding: 200rpx 0;
}
.empty-text {
  display: block;
  font-size: 30rpx;
  color: var(--color-text-muted);
  margin-bottom: 8rpx;
}
.empty-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ---- 底部安全区 ---- */
.safe-bottom {
  height: 40rpx;
}

/* ========================================
   城市选择底部弹窗
   ======================================== */
.city-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}
.city-popup-mask.show {
  opacity: 1;
  pointer-events: auto;
}
.city-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 85vh;
  background: var(--color-surface);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1001;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.city-popup.show {
  transform: translateY(0);
}
.city-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}
.city-popup-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}
.city-popup-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-surface-input);
}
.city-popup-close text {
  font-size: 24rpx;
  color: var(--color-text-muted);
}
.city-popup-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx;
  -webkit-overflow-scrolling: touch;
}
.city-section {
  margin-top: 24rpx;
}
.city-section-title {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-bottom: 12rpx;
}

/* 当前定位标签 */
.location-tag {
  background: var(--color-success-bg);
  border: 1rpx solid var(--color-success-border);
  display: inline-flex;
}

/* 城市标签 */
.city-tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.city-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: var(--color-surface-input);
  border: 1rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-text);
  transition: all 0.15s ease;
  white-space: nowrap;
}
.city-tag-name {
  font-size: 24rpx;
  color: var(--color-text);
}
.city-tag.active {
  background: var(--color-brand-light);
  border-color: var(--color-brand);
}
.city-tag.active .city-tag-name {
  color: var(--color-primary);
  font-weight: 600;
}
.selected-tag {
  background: var(--color-brand-light);
  border-color: var(--color-brand);
}
.selected-tag .city-tag-name {
  color: var(--color-primary);
  font-weight: 600;
}

/* 热门城市 */
.city-hot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.hot-tag {
  background: var(--color-danger-bg);
  border: 1rpx solid var(--color-danger-border);
}
.hot-tag .city-tag-name {
  color: var(--color-danger);
}
.hot-tag.active {
  background: var(--color-danger-bg);
  border-color: var(--color-danger);
}
.hot-tag.active .city-tag-name {
  color: var(--color-danger);
}

/* 字母标题 */
.city-letter-header {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-brand);
  padding: 16rpx 0 10rpx;
  border-bottom: 1rpx solid var(--color-border);
  position: sticky;
  top: 0;
  background: var(--color-surface);
  z-index: 2;
}
.city-list-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 12rpx 0;
}
.city-loading {
  text-align: center;
  padding: 80rpx 0;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

/* 字母索引导航 */
.alphabet-index {
  position: fixed;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1002;
  pointer-events: auto;
}
.alphabet-item {
  font-size: 18rpx;
  font-weight: 600;
  color: #3A7BD5;
  padding: 2rpx 6rpx;
  line-height: 1.3;
  text-align: center;
}
.alphabet-item:active {
  color: var(--color-brand);
}
.theme-dark .alphabet-item {
  color: #5B8FE8;
}

/* 弹窗底部 */
.city-popup-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
  gap: 20rpx;
  flex-shrink: 0;
  background: var(--color-surface);
}
.city-footer-left {
  padding: 0;
  background: none;
}
.city-footer-left text {
  font-size: 24rpx;
  color: var(--color-text-muted);
}
.city-footer-right {
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  background: var(--color-primary);
  text-align: center;
}
.city-footer-right text {
  font-size: 24rpx;
  color: var(--color-text-inverse);
}

/* ========================================
   暗色模式
   ======================================== */

/* 暗色主题（仅页面特有覆盖） */
.theme-dark .trip-card {
  background: transparent;
  border: none;
}
.theme-dark .card-title {
  color: var(--color-text);
}
.theme-dark .card-username,
.theme-dark .card-like text {
  color: var(--color-text-muted);
}

/* ---- 加载更多 ---- */
.theme-dark .trip-card:active {
  opacity: 0.7;
}

/* 暗色 - 城市弹窗 */
.theme-dark .city-popup {
  background: var(--color-surface);
}
.theme-dark .city-popup-header {
  border-bottom-color: var(--color-border);
}
.theme-dark .city-popup-title {
  color: var(--color-text);
}
.theme-dark .city-popup-close {
  background: var(--color-surface-input);
}
.theme-dark .city-popup-close text {
  color: var(--color-text-muted);
}
.theme-dark .city-section-title {
  color: var(--color-text-muted);
}
.theme-dark .city-tag {
  background: var(--color-surface-input);
  border-color: var(--color-border);
}
.theme-dark .city-tag-name {
  color: var(--color-text-secondary);
}
.theme-dark .city-tag.active {
  background: var(--color-brand-light);
  border-color: var(--color-brand);
}
.theme-dark .city-tag.active .city-tag-name {
  color: var(--color-brand);
}
.theme-dark .selected-tag {
  background: var(--color-brand-light);
  border-color: var(--color-brand);
}
.theme-dark .selected-tag .city-tag-name {
  color: var(--color-brand);
}
.theme-dark .hot-tag {
  background: var(--color-danger-bg);
  border-color: var(--color-danger-border);
}
.theme-dark .hot-tag .city-tag-name {
  color: var(--color-danger);
}
.theme-dark .hot-tag.active {
  background: var(--color-danger-bg);
  border-color: var(--color-danger);
}
.theme-dark .location-tag {
  background: var(--color-brand-light);
  border-color: var(--color-brand-light);
}
.theme-dark .city-letter-header {
  color: var(--color-brand);
  border-bottom-color: var(--color-border);
  background: var(--color-surface);
}
.theme-dark .city-popup-footer {
  border-top-color: var(--color-border);
  background: var(--color-surface);
}
.theme-dark .city-footer-left text {
  color: var(--color-text-muted);
}

