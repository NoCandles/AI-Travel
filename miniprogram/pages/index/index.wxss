}
.xhs-side-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.xhs-side-btn:active {
  opacity: 0.62;
}
.xhs-side-icon {
  width: 38rpx;
  height: 38rpx;
  opacity: 0.92;
  padding: 8rpx;
}
.xhs-side-btn.search .xhs-side-icon {
  width: 40rpx;
  height: 40rpx;
}

/* ---- 横向滚动标签栏（推荐/最新 + 城市 + 天数 + 标签） ---- */
.xhs-tabs-scroll {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  white-space: nowrap;
}
.xhs-tabs {
  display: inline-flex;
  align-items: center;
  height: 88rpx;
  gap: 32rpx;
  padding: 0 24rpx;
  min-width: max-content;
  box-sizing: border-box;
}
.xhs-tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  height: 88rpx;
  color: var(--color-text-muted);
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1;
}
.xhs-tab.active {
  color: var(--color-primary);
  font-weight: 700;
}
.xhs-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 44rpx;
  height: 5rpx;
  border-radius: 5rpx;
  background: var(--color-primary);
  transform: translateX(-50%);
}
.xhs-tab.city,
.xhs-tab.picker {
  color: var(--color-text-muted);
}

/* 标签圆角按钮（全部 + hotTags） */
.xhs-tag {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 20rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: var(--color-surface-alt);
  line-height: 1;
}
.xhs-tag.active {
  color: var(--color-primary);
  font-weight: 600;
  background: var(--color-brand-light);
}
.xhs-category-arrow {
  width: 13rpx;
  height: 13rpx;
  opacity: 0.42;
  margin-top: 2rpx;
}
.theme-dark .header,
.theme-dark .xhs-topbar {
  background: var(--color-surface);
}
.theme-dark .xhs-tab.active {
  color: var(--color-text);
}
.theme-dark .xhs-tab {
  color: var(--color-text-muted);
}

/* ---- 搜索行（替换 tabs 区域） ---- */
.xhs-search-row {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}
.xhs-search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  color: var(--color-text);
  font-size: 28rpx;
  padding-left: 16rpx;
}
.xhs-search-cancel {
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 16rpx;
  flex-shrink: 0;
}

/* Discovery card render fallback */
.waterfall-wrap {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  width: 100%;
  padding: 0 16rpx;
  box-sizing: border-box;
}
.waterfall-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.trip-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow: hidden;
  border-radius: 4rpx;
  background: var(--color-surface);
}
.card-cover-wrap {
  position: relative;
  width: 100%;
  min-height: 220rpx;
  background: var(--color-surface-alt);
  border-radius: 4rpx 4rpx 0 0;
}
.card-cover {
  width: 100%;
  min-height: 220rpx;
  display: block;
}
.card-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 16rpx 4rpx 18rpx;
  background: var(--color-surface);
  border-radius: 0 0 4rpx 4rpx;
}
