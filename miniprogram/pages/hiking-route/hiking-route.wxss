.hiking-page { min-height: 100vh; padding: 0 24rpx 150rpx; background: var(--color-surface-alt); box-sizing: border-box; }
.hero { margin: 0 -24rpx 24rpx; padding: 42rpx 32rpx 34rpx; color: #fff; background: linear-gradient(145deg, var(--color-brand-deep), var(--color-brand)); }
.route-chooser { display: flex; gap: 12rpx; margin: -8rpx 0 24rpx; overflow-x: auto; white-space: nowrap; }
.route-option { min-width: 228rpx; padding: 18rpx 20rpx; color: var(--color-text-secondary); background: var(--color-surface); border: 1rpx solid var(--color-border-light); border-radius: var(--radius-lg); box-sizing: border-box; }
.route-option.active { color: var(--color-brand-deep); background: var(--color-brand-soft); border-color: var(--color-brand); }
.route-option text, .route-option span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.route-option text { font-size: 25rpx; font-weight: 700; }.route-option span { margin-top: 6rpx; font-size: 21rpx; opacity: .82; }
.hero-kicker { font-size: 22rpx; opacity: .8; letter-spacing: 1rpx; }
.hero-title { margin-top: 12rpx; font-size: 48rpx; line-height: 1.2; font-weight: 700; }
.hero-route { margin-top: 12rpx; font-size: 25rpx; opacity: .88; }
.hero-route text { margin: 0 8rpx; }
.hero-stats { display: flex; margin-top: 30rpx; gap: 18rpx; }
.hero-stats view { flex: 1; min-width: 0; }
.hero-stats text { display: inline-block; font-size: 31rpx; font-weight: 700; }.hero-stats em { margin-left: 3rpx; font-size: 20rpx; font-style: normal; }.hero-stats span { display: block; margin-top: 5rpx; font-size: 20rpx; opacity: .75; }
.card { background: var(--color-surface); border-radius: var(--radius-lg); box-shadow: var(--card-shadow); border: var(--card-border); }
.map-wrap { position: relative; overflow: hidden; padding: 0; }.trail-map { width: 100%; height: 420rpx; }.map-badge { position: absolute; right: 20rpx; bottom: 20rpx; padding: 12rpx 18rpx; border-radius: var(--radius-full); color: var(--color-text); background: var(--glass-bg); font-size: 22rpx; }
.section, .status-card { margin-top: 24rpx; padding: 26rpx; }.section-head { display: flex; justify-content: space-between; margin-bottom: 18rpx; color: var(--color-text); font-size: 28rpx; font-weight: 700; }.section-head text:last-child { color: var(--color-brand); font-size: 22rpx; font-weight: 500; }
.segment { display: flex; gap: 18rpx; padding: 18rpx 0; border-top: 1rpx solid var(--color-border-light); }.segment-icon { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; color: var(--color-brand); background: var(--color-brand-soft); border-radius: 50%; font-size: 20rpx; font-weight: 700; }.segment text, .segment span { display: block; }.segment text { color: var(--color-text); font-size: 26rpx; font-weight: 600; }.segment span { margin-top: 6rpx; color: var(--color-text-muted); font-size: 22rpx; }
.check-item { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-top: 1rpx solid var(--color-border-light); color: var(--color-text-secondary); font-size: 25rpx; }.check { display: flex; flex: 0 0 auto; width: 30rpx; height: 30rpx; align-items: center; justify-content: center; border: 2rpx solid var(--color-border); border-radius: 50%; color: #fff; font-size: 20rpx; }.checked { border-color: var(--color-brand); background: var(--color-brand); }
.status-card { display: flex; align-items: center; justify-content: space-between; color: var(--color-text-secondary); font-size: 23rpx; }.status-card view { display: flex; flex-direction: column; }.status-kicker { color: var(--color-brand); font-size: 22rpx; }.status-time { margin-top: 4rpx; color: var(--color-text); font-size: 36rpx; font-weight: 700; }.success .status-kicker { color: var(--color-success); }
.bottom-actions { position: fixed; z-index: 5; right: 0; bottom: 0; left: 0; display: flex; gap: 18rpx; padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--glass-bg); border-top: 1rpx solid var(--color-border-light); }.primary-action, .sub-action { flex: 1; padding: 22rpx 16rpx; border-radius: var(--radius-full); font-size: 27rpx; font-weight: 600; }.primary-action { color: #fff; background: var(--color-brand); }.sub-action { color: var(--color-brand); background: var(--color-brand-soft); }
.safety-section { padding-bottom: 12rpx; }.safety-item { display: flex; gap: 12rpx; padding: 14rpx 0; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.5; border-top: 1rpx solid var(--color-border-light); }.safety-item text { display: flex; flex: 0 0 28rpx; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; margin-top: 4rpx; color: #fff; background: var(--color-warning); border-radius: 50%; font-size: 20rpx; font-weight: 700; }
