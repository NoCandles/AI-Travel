/* ========================================
   拾路派 - 编辑资料 — 所有 Token 由 variables.wxss 统一提供
   ======================================== */

/* ---- 页面容器 ---- */
.edit-page {
  position: relative;
  padding: 40rpx var(--space-page-x) 40rpx;
  min-height: 100vh;
  background: var(--color-surface-alt);
  box-sizing: border-box;
}

/* ---- 深色模式页面背景（强制覆盖，规避跨页面 CSS 变量级联不可靠） ---- */
.theme-dark.edit-page,
.edit-page.theme-dark {
  background: #111318;
  color: var(--color-text);
}

/* ---- 头部 ---- */
.page-header {
  text-align: center;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-dark);
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--color-muted);
}

/* ---- 卡片 ---- */
.card {
  background: transparent;
  border-radius: 0;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
  box-shadow: none;
  border: none;
}

/* ---- 头像卡片 ---- */
.avatar-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.avatar-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-dark);
}

.avatar-desc {
  font-size: 24rpx;
  color: var(--color-muted);
}

.avatar-wrapper {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: visible;
  flex-shrink: 0;
}

.avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-text-inverse);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--color-brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.avatar-camera {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;

  border: 2rpx solid var(--color-text-inverse);}

/* ---- 列表项 ---- */
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.list-item.last {
  border-bottom: none;
  padding-bottom: 0;
}

.list-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.list-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.list-icon.nickname { background: var(--color-info-bg); }
.list-icon.gender { background: var(--color-danger-bg); }
.list-icon.city { background: var(--color-brand-light); }
.list-icon.intro { background: var(--color-accent-light); }

.list-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-dark);
}

.list-desc {
  font-size: 22rpx;
  color: var(--color-muted);
}

.list-input {
  font-size: 28rpx;
  color: var(--color-text);
  text-align: right;
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.list-placeholder {
  color: var(--color-placeholder);
  font-size: 24rpx;
}

.list-value {
  font-size: 28rpx;
  color: var(--color-text);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.list-arrow {
  font-size: 34rpx;
  color: var(--color-text-muted);
}

/* ---- 简介区 ---- */
.intro-section {
  padding-top: 20rpx;
}

.intro-textarea {
  width: 100%;
  min-height: 180rpx;
  border: none;
  background: var(--color-surface);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--color-text);
  box-sizing: border-box;

  border: 1rpx solid rgba(0,0,0,0.03);}

.intro-placeholder {
  color: var(--color-placeholder);
}

.intro-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--color-placeholder);
  margin-top: 12rpx;
}

/* ---- 保存按钮 ---- */
.save-btn {
  width: 100%;
  padding: 28rpx 0;
  background: var(--color-brand);
  color: var(--color-text-inverse);
  border: none;
  border-radius: 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin: 8rpx 0 24rpx;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.save-btn::after { border: none; }

/* ---- 底部提示 ---- */
.footer-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-muted);
  padding-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.footer-tip-icon {
  width: 26rpx;
  height: 26rpx;
  opacity: .72;
}

/* ======== 暗色主题（仅页面特有覆盖） ======== */
.theme-dark .card {
  background: transparent;
  border: none;
}

.theme-dark .list-item {
  border-bottom-color: var(--color-divider);
}

.theme-dark .intro-textarea {
  background: var(--color-surface-input);
  color: var(--color-text);
  border: var(--card-border);
}

.theme-dark .avatar-placeholder {
  background: var(--color-brand-light);
}

/* ---- SVG Icon Images ---- */
.camera-icon {
  width: 24rpx;
  height: 24rpx;
  display: block;
}

.save-btn-icon {
  width: 32rpx;
  height: 32rpx;
  display: inline-block;
  vertical-align: middle;
}
