}

.theme-dark .creator-panel .packing-card {
  border-color: var(--color-border);
}

/* 本轮微调：作者卡片悬浮、四栏导航、日期按钮稳定间距 */
.gallery-card {
  height: 620rpx;
}

.hero-content {
  bottom: 302rpx;
}

.creator-panel {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 18rpx;
