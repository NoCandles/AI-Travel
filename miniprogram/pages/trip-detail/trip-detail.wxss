  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(5, 39, 42, 0.22);
}

.creator-panel {
  padding: 12rpx 24rpx 14rpx;
  background: var(--color-surface);
}

.author-row {
  min-height: 66rpx;
}

.author-main {
  gap: 18rpx;
}

.author-avatar {
  width: 62rpx;
  height: 62rpx;
  border: 2rpx solid rgba(46, 196, 182, 0.2);
}

.author-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-name {
  font-size: 24rpx;
  font-weight: 700;
}

.author-level {
  padding: 3rpx 11rpx;
  border-radius: 999rpx;
  background: var(--color-brand);
  color: #fff;
  font-size: 17rpx;
  font-weight: 800;
}

.author-desc {
  margin-top: 4rpx;
  font-size: 19rpx;
}

.follow-btn {
  min-width: 112rpx;
  padding: 10rpx 22rpx;
  border: 2rpx solid var(--color-brand);
  background: transparent;
  color: var(--color-brand-deep);
  font-size: 22rpx;
}

.follow-btn.followed {
  border-color: var(--color-border);
}

.creator-panel .action-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0;
  margin: 9rpx 0 0;
  padding: 8rpx 0;
  border-top: 1rpx solid var(--color-border-light);
}

.creator-panel .action-item,
.creator-panel button.share-btn-action {
  width: 100%;
  height: 52rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1.15;
}

.creator-panel .action-item image {
  width: 29rpx;
  height: 29rpx;
  opacity: .88;
  filter: grayscale(1) brightness(.36);
}

.action-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
}

.action-value {
  color: var(--color-text);
  font-size: 17rpx;
  font-weight: 600;
}

.action-label {
  color: var(--color-text-muted);
  font-size: 16rpx;
  font-weight: 500;
}

.action-label.single {
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.creator-panel .action-item.active,
.creator-panel .action-item.active .action-value,
.creator-panel .action-item.active .action-label {
  color: var(--color-brand-deep);
}

.creator-panel .action-item.active image {
  filter: none;
}

.creator-panel .packing-card {
  display: grid;
  grid-template-columns: 48rpx 152rpx 1fr 24rpx;
  align-items: center;
  gap: 10rpx;
  margin: 0;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(46, 196, 182, 0.12);
  border-radius: 14rpx;
  background: #f8fcfb;
  box-shadow: 0 6rpx 18rpx rgba(24, 118, 108, 0.05);
}

.creator-panel .packing-icon {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: rgba(46, 196, 182, 0.12);
}

.creator-panel .packing-icon image {
  width: 28rpx;
  height: 28rpx;
}

.creator-panel .packing-title-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.creator-panel .packing-title {
  font-size: 23rpx;
  font-weight: 700;
}

.creator-panel .packing-progress,
.creator-panel .packing-sub {
  margin: 0;
  color: var(--color-text-muted);
  font-size: 17rpx;
  font-weight: 500;
}

.creator-panel .packing-bar {
  height: 7rpx;
  margin: 0;
  background: #eaf1ef;
}

.creator-panel .packing-fill {
  background: var(--color-brand);
}

.packing-arrow-icon {
  width: 21rpx;
  height: 21rpx;
  opacity: .72;
}

.sticky-tabs {
  top: 0;
  height: 68rpx;
  margin: 0;
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid var(--color-border-light);
  border-bottom: 1rpx solid var(--color-border-light);
}

.tab-item {
  position: relative;
  height: 68rpx;
  gap: 6rpx;
  border-radius: 0;
  color: #8b9498;
  font-size: 21rpx;
  font-weight: 600;
}

.tab-item image {
  width: 25rpx;
  height: 25rpx;
  opacity: .7;
}

.tab-item.active {
  background: transparent;
  color: var(--color-brand);
  box-shadow: none;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 0;
  height: 5rpx;
  border-radius: 999rpx;
  background: var(--color-brand);
}

.tab-item.active image {
  opacity: 1;
}

.content {
  padding: 0;
}

.tab-content {
  margin-top: 0;
}

.route-execution {
  background: #f2f8f6;
}

.route-map-wrap {
  position: relative;
}

.trip-map.route-map {
  height: 470rpx;
  min-height: 0;
  transition: height 220ms ease;
}

.route-execution.sheet-collapsed {
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
}

.route-execution.sheet-collapsed .trip-map.route-map {
  height: calc(100vh - 440rpx - env(safe-area-inset-bottom));
  min-height: 600rpx;
}

.map-day-rail {
  position: absolute;
  top: 26rpx;
  left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.map-day-pill {
  min-width: 76rpx;
  padding: 13rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #4f5e61;
  font-size: 20rpx;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(31, 73, 70, 0.12);
}

.map-day-pill.active {
  background: var(--color-brand);
  color: #fff;
}

.map-side-tools {
  position: absolute;
  top: 28rpx;
  right: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.map-tool,
.map-zoom {
  width: 82rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #526063;
  box-shadow: 0 8rpx 20rpx rgba(31, 73, 70, 0.13);
}

.map-tool {
  min-height: 76rpx;
  padding: 10rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  font-size: 17rpx;
}

.map-tool cover-image {
  width: 29rpx;
  height: 29rpx;
}

.map-side-tools .map-tool:first-child {
  color: var(--color-brand-deep);
}

.map-zoom {
  padding: 7rpx 0;
  font-size: 37rpx;
  line-height: 58rpx;
  text-align: center;
}

.zoom-divider {
  height: 1rpx;
  margin: 0 15rpx;
  background: #e5e9e8;
}

.map-mode-dock {
  position: absolute;
  right: 22rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 5rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 24rpx rgba(31, 73, 70, 0.14);
}

.map-mode-dock.with-collapsed-sheet {
  position: fixed;
  top: auto;
  right: 30rpx;
  bottom: calc(146rpx + env(safe-area-inset-bottom));
  z-index: 29;
}

.map-collapsed-sheet {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  top: auto;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  z-index: 30;
  box-sizing: border-box;
  min-height: 100rpx;
  padding: 7rpx 18rpx 12rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 12rpx 34rpx rgba(30, 73, 69, 0.2);
}

.map-collapsed-handle {
  width: 44rpx;
  height: 5rpx;
  margin: 0 auto 7rpx;
  border-radius: 999rpx;
  background: rgba(87, 111, 108, 0.28);
}

.map-collapsed-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.map-collapsed-day {
  flex-shrink: 0;
  padding: 6rpx 10rpx;
  border-radius: 9rpx;
  background: rgba(46, 196, 182, 0.13);
  color: var(--color-brand-deep);
  font-size: 19rpx;
  font-weight: 800;
}

.map-collapsed-copy {
  flex: 1;
  min-width: 0;
}

.map-collapsed-route {
  display: flex;
  min-width: 0;
  overflow: hidden;
  color: var(--color-text);
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.map-collapsed-place {
  flex-shrink: 0;
}

.map-collapsed-hint {
  margin-top: 4rpx;
  color: var(--color-text-muted);
  font-size: 16rpx;
}

.map-collapsed-arrow {
  flex-shrink: 0;
  width: 26rpx;
  height: 26rpx;
  padding: 6rpx;
  border-radius: 50%;
  background: rgba(46, 196, 182, 0.14);
}

.mode-option {
  height: 54rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
  border-radius: 999rpx;
  color: #596568;
  font-size: 19rpx;
}

.mode-option cover-image {
  width: 26rpx;
  height: 26rpx;
}

.mode-option.active {
  background: rgba(46, 196, 182, 0.12);
  color: var(--color-brand-deep);
  font-weight: 700;
}

.itinerary-sheet {
  position: relative;
  z-index: 4;
  margin-top: -28rpx;
  padding: 8rpx 22rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: var(--color-surface);
  box-shadow: 0 -10rpx 28rpx rgba(30, 73, 69, 0.09);
}

.sheet-handle {
  width: 112rpx;
  height: 30rpx;
  margin: -4rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-handle-bar {
  width: 52rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #d5d9d8;
}

.itinerary-heading {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) 36rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx 12rpx;
}

.itinerary-day {
  color: var(--color-text);
  font-size: 23rpx;
  font-weight: 800;
}

.itinerary-copy,
.itinerary-summary {
  min-width: 0;
}

.itinerary-summary {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--color-text);
  font-size: 21rpx;
  font-weight: 600;
}

.sheet-toggle-icon {
  width: 28rpx;
  height: 28rpx;
  padding: 5rpx;
  border-radius: 50%;
  background: rgba(46, 196, 182, 0.1);
  transform: rotate(180deg);
  transition: transform 180ms ease;
}

.execution-list {
  padding: 0 8rpx;
}

.execution-item {
  display: grid;
  grid-template-columns: 64rpx 28rpx minmax(0, 1fr) 102rpx 20rpx;
  align-items: start;
  gap: 10rpx;
  min-height: 90rpx;
  padding: 6rpx 0;
}

.execution-time {
  padding-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 19rpx;
  font-weight: 600;
}

.execution-track {
  position: relative;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.execution-dot {
  position: relative;
  z-index: 2;
  width: 25rpx;
  height: 25rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-brand);
  color: #fff;
  font-size: 15rpx;
  font-weight: 800;
  box-shadow: 0 0 0 6rpx rgba(46, 196, 182, 0.11);
}

.execution-line {
  width: 2rpx;
  flex: 1;
  min-height: 66rpx;
  margin-top: 5rpx;
  background: #d6dddb;
}

.execution-main {
  min-width: 0;
  padding-top: 4rpx;
}

.execution-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.execution-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--color-text);
  font-size: 22rpx;
  font-weight: 700;
}

.execution-type {
  flex-shrink: 0;
  padding: 4rpx 9rpx;
  border-radius: 8rpx;
  background: rgba(46, 196, 182, 0.11);
  color: var(--color-brand-deep);
  font-size: 15rpx;
  font-weight: 600;
}

.execution-duration {
  display: block;
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 18rpx;
}

.execution-cover {
  width: 102rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #e9eeed;
}

.execution-arrow {
  width: 20rpx;
  height: 20rpx;
  margin-top: 22rpx;
  opacity: .55;
}

.execution-main .route-guide {
  grid-column: 1 / -1;
  margin-top: 12rpx;
}

.navigation-cta {
  width: 100%;
  height: 70rpx;
  margin: 14rpx 0 0;
  border-radius: 999rpx;
  background: var(--color-brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  box-shadow: 0 10rpx 24rpx rgba(46, 196, 182, 0.22);
}

.navigation-cta image {
  width: 29rpx;
  height: 29rpx;
  filter: brightness(0) invert(1);
}

.navigation-cta::after {
  border: none;
}

.navigation-cta.compact {
  height: 78rpx;
  margin-top: 20rpx;
  font-size: 27rpx;
}

.map-content {
  margin: 0;
}

.spots-content,
.tab-content:not(.route-execution):not(.map-content) {
  padding: 24rpx;
}

.theme-dark.page {
  background: var(--color-surface-alt);
}

.theme-dark .creator-panel,
.theme-dark .sticky-tabs,
.theme-dark .itinerary-sheet {
