@import "../../styles/variables.wxss";

.page {
  min-height: 100vh;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
  background: var(--color-surface-alt);
  color: var(--color-text);
  font-family: var(--font-family);
}

.loading {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: var(--color-text-muted);
  font-size: 28rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid var(--color-brand-12);
  border-top-color: var(--color-brand);
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.cover-preview {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  background: var(--color-surface);
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(10, 18, 30, 0.12) 0%, rgba(10, 18, 30, 0.22) 42%, rgba(10, 18, 30, 0.78) 100%);
}

.cover-copy {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 48rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.cover-kicker {
  align-self: flex-start;
  max-width: 560rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  background: rgba(46, 196, 182, 0.92);
  color: var(--color-text-inverse);
  font-size: 22rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cover-title {
  color: var(--color-text-inverse);
  font-size: 46rpx;
  line-height: 1.2;
  font-weight: 800;
}

.content {
  position: relative;
  z-index: 2;
  margin-top: -28rpx;
  padding: 0 var(--space-page-x);
}

.section-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-xl);
  background: var(--color-surface);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.section-count {
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.title-input,
.desc-input,
.content-input,
.tag-input {
  box-sizing: border-box;
  width: 100%;
  border-radius: var(--radius-lg);
  background: var(--color-surface-input);
  color: var(--color-text);
  font-size: 28rpx;
}

.title-input {
  height: 88rpx;
  padding: 0 24rpx;
  font-weight: 700;
}

.desc-input {
  min-height: 112rpx;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  line-height: 1.55;
}

.content-input {
  min-height: 260rpx;
  padding: 24rpx;
  line-height: 1.65;
}

.tag-editor {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tag-input {
  flex: 1;
  height: 76rpx;
  padding: 0 22rpx;
}

.tag-add {
  width: 136rpx;
  height: 76rpx;
  padding: 0;
  border-radius: var(--radius-full);
  background: var(--color-brand);
  color: var(--color-text-inverse);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.tag-add::after,
.publish-btn::after,
.image-remove::after,
.set-cover::after {
  border: none;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.tag {
  padding: 10rpx 18rpx;
  border-radius: var(--radius-full);
  background: var(--color-surface-input);
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.tag.active,
.tag.selected {
  background: var(--color-brand-light);
  color: var(--color-brand-deep);
  font-weight: 700;
}

.selected-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.selected-item,
.upload-card {
  position: relative;
  height: 196rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-surface-input);
}

.selected-item image {
  width: 100%;
  height: 100%;
}

.selected-item video,
.candidate-item video {
  width: 100%;
  height: 100%;
}

.cover-badge,
.candidate-check,
.set-cover {
  position: absolute;
  left: 10rpx;
  bottom: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-full);
  background: rgba(46, 196, 182, 0.92);
  color: var(--color-text-inverse);
  font-size: 20rpx;
  font-weight: 700;
}

.image-remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 44rpx;
  height: 44rpx;
  padding: 0;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 30rpx;
  line-height: 40rpx;
}

.set-cover {
  background: rgba(0, 0, 0, 0.48);
}

.upload-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx dashed var(--color-border);
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.upload-plus {
  color: var(--color-brand);
  font-size: 52rpx;
  line-height: 1;
}

.candidate-scroll {
  width: 100%;
}

.candidate-list {
  display: flex;
  gap: 14rpx;
  padding-bottom: 4rpx;
}

.candidate-item {
  position: relative;
  width: 184rpx;
  height: 138rpx;
  flex-shrink: 0;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-surface-input);
}

.candidate-item.cover {
  box-shadow: 0 0 0 4rpx var(--color-brand);
}

.candidate-item image {
  width: 100%;
  height: 100%;
}

.candidate-check {
  left: auto;
  right: 8rpx;
  bottom: 8rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--glass-bg);
  backdrop-filter: blur(var(--glass-blur));
  border-top: 1rpx solid var(--color-border-light);
}

.bottom-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.publish-btn {
  width: 240rpx;
  height: 88rpx;
  padding: 0;
  border-radius: var(--radius-full);
  background: var(--color-accent);
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.theme-dark .section-card {
  background: var(--color-surface);
}
