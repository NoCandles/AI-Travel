/* ========================================
   拾路派 - 我的行程
   所有 Token 统一由 styles/variables.wxss 提供
   ======================================== */

/* ---- 页面容器 ---- */
.page {
  position: relative;
  background: var(--color-bg);
  padding: 0 var(--space-page-x);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---- 深色模式页面背景（强制覆盖，规避跨页面 CSS 变量级联不可靠） ---- */
.theme-dark.page,
.page.theme-dark {
  background: #111318;
  color: var(--color-text);
}

/* ---- Header ---- */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.header-left {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  color: var(--color-dark);
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.header-indicator {
  width: 72rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 4rpx;
}

.btn-new-trip {
  padding: 16rpx 32rpx;
  background: var(--color-brand);
  color: var(--color-text-inverse);
  border: none;
    border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.btn-new-trip::after {
  border: none;
}

/* ---- 统计卡片 ---- */
.stats-card {
  display: flex;
  justify-content: space-around;
  background: transparent;
  border-radius: 0;
  padding: 36rpx 20rpx;
  margin-bottom: 32rpx;
  box-shadow: none;
  position: relative;
  z-index: 1;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.stat-icon.all {
  background: var(--color-success-bg);
}

.stat-icon.active {
  background: var(--color-info-bg);
}

.stat-icon.completed {
  background: var(--color-warning-bg);
}

.stat-icon.favorite {
  background: var(--color-danger-bg);
}

.stat-number {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-dark);
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-muted);
  font-weight: 500;
}

/* ---- 行程列表区 ---- */
.trip-section {
  position: relative;
  z-index: 1;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-dark);
}

.section-filter {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  font-weight: 500;
}

.filter-arrow {
  font-size: 18rpx;
}

/* ---- 行程卡片 ---- */
.trip-card {
  background: var(--color-surface);
  border-radius: 0;
  margin-bottom: 24rpx;
  overflow: hidden;
  display: flex;
  box-shadow: none;
  position: relative;
  border: none;
}

/* 左侧色条装饰 */
.trip-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 6rpx;
  background: var(--color-brand);
  border-radius: 0 3rpx 3rpx 0;
}

.trip-image {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  background: var(--color-brand);
  position: relative;
  overflow: hidden;
  border-radius: 16rpx 0 0 16rpx;
}

.trip-image::after {
  content: '';
  position: absolute;
  bottom: -24rpx;
  right: -24rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 50%;
}

.trip-content {
  flex: 1;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0; 
}

.trip-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.trip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-dark);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-status {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.trip-status.SAVED {
  background: var(--color-info-bg);
  color: var(--color-info);
}

.trip-status.ONGOING {
  background: var(--color-brand-light);
  color: var(--color-brand);
}

.trip-status.COMPLETED {
  background: var(--color-surface-alt);
  color: var(--color-text-secondary);
}

.trip-meta {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: var(--color-muted);
  font-weight: 500;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.trip-tags {
  display: flex;
  gap: 8rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background: var(--color-info-bg);
  color: #7B61FF;
  font-weight: 600;
}

.trip-actions {
  display: flex;
  gap: 8rpx;
  border-top: 1rpx solid #f0f2f5;
  border-top-color: rgba(46,196,182,0.06);
  padding-top: 12rpx;
}

.act-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  background: var(--color-surface-alt);
  border: none;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: var(--color-muted);
  font-weight: 600;
  padding: 8rpx 0;
  line-height: 1;
}

.act-btn::after {
  border: none;
}

.act-btn.start {
  background: var(--color-brand-light);
  color: var(--color-brand);
  font-weight: 700;
}

.act-btn.finish {
  background: var(--color-accent-light);
  color: var(--color-accent);
  font-weight: 700;
}

.act-btn.del {
  color: var(--color-danger);
  background: var(--color-danger-bg);
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 100rpx 40rpx;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  background: var(--color-surface-alt);
  border-radius: 50%;
  position: relative;
}

.empty-icon-img {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 64rpx;
  height: 64rpx;
  transform: translate(-50%, -50%);
  opacity: 0.4;
}
.trip-header-right { display: flex; align-items: center; gap: 8rpx; }
.trip-mode { display: flex; align-items: center; gap: 4rpx; padding: 4rpx 10rpx; border-radius: 999rpx; background: var(--color-surface-alt); color: var(--color-text-secondary); font-size: 18rpx; line-height: 1; }
.trip-mode image { width: 20rpx; height: 20rpx; }.trip-mode.mode-walk { color: var(--color-brand-deep); background: var(--color-brand-soft); }.trip-mode.mode-drive { color: var(--color-info); background: var(--color-info-bg); }.trip-mode.mode-transit { color: #b7791f; background: #fff7e6; }

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-dark);
}

.empty-subtitle {
  font-size: 24rpx;
  color: var(--color-muted);
}

.btn-create {
  padding: 24rpx 48rpx;
  background: var(--color-brand);
  color: var(--color-text-inverse);
  border: none;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.btn-create::after {
  border: none;
}

/* ======== 暗色主题（仅页面特有覆盖） ======== */
.theme-dark .stats-card,
.theme-dark .empty-state {
  background: transparent;
}

.theme-dark .trip-card {
  background: transparent;
  border: none;
  box-shadow: none;
}

.theme-dark .trip-title,
.theme-dark .header-title,
.theme-dark .stat-number,
.theme-dark .section-title,
.theme-dark .empty-title {
  color: var(--color-text);
}

.theme-dark .header-subtitle,
.theme-dark .stat-label,
.theme-dark .filter-label,
.theme-dark .meta-item,
.theme-dark .tag,
.theme-dark .empty-subtitle {
  color: var(--color-text-muted);
}

.theme-dark .btn-new-trip,
.theme-dark .btn-create {
  background: var(--color-brand);
}

.theme-dark .trip-actions {
  border-top-color: var(--color-divider);
}

.theme-dark .act-btn {
  background: var(--color-surface-input);
  color: var(--color-text-muted);
}

.theme-dark .act-btn.del {
  background: var(--color-danger-bg);
  color: var(--color-danger);
}

.theme-dark .act-btn.start {
  background: var(--color-brand-light);
  color: var(--color-brand);
}

.theme-dark .act-btn.finish {
  background: var(--color-accent-light);
  color: var(--color-accent);
}

.theme-dark .empty-icon {
  background: var(--color-surface-input);
}

.theme-dark .trip-status.SAVED {
  background: var(--color-info-bg);
  color: var(--color-info);
}

.theme-dark .trip-status.ONGOING {
  background: var(--color-brand-light);
  color: var(--color-brand);
}

.theme-dark .trip-status.COMPLETED {
  background: var(--color-surface-input);
  color: var(--color-text-muted);
}

.theme-dark .tag {
  background: var(--color-info-bg);
  color: var(--color-info);
}

.theme-dark .trip-card::before {
  opacity: 0.8;
}

/* ---- 当前行程入口（进行中） ---- */
.ongoing-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #2EC4B6 0%, #3DD598 100%);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(46, 196, 182, 0.35);
}
.ongoing-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ongoing-icon {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
}
.ongoing-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.ongoing-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
}
.ongoing-count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}
.ongoing-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.ongoing-action {
  font-size: 24rpx;
  color: var(--color-text-inverse);
  font-weight: 600;
}
.ongoing-arrow {
  font-size: 30rpx;
  color: var(--color-text-inverse);
}

/* ---- AI Banner ---- */
.ai-banner {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.ai-banner-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ai-icon {
  font-size: 56rpx;
  flex-shrink: 0;
}

.ai-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ai-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
}

.ai-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.ai-arrow {
  font-size: 36rpx;
  color: var(--color-text-inverse);
  flex-shrink: 0;
}

/* ---- 行程分类Tab ---- */
.trip-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  background: var(--color-bg);
  border-radius: 0;
  padding: 12rpx 0;
  box-shadow: none;
  position: sticky;
  top: 0;
  z-index: 10;
}

.trip-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  font-weight: 600;
  transition: all 0.3s;
}

.trip-tab.active {
  background: var(--color-brand);
  color: var(--color-text-inverse);
}

.tab-count {
  font-size: 22rpx;
  font-weight: 700;
}

.trip-tab.active .tab-count {
  color: rgba(255, 255, 255, 0.9);
}

/* ---- 暗色主题补充 ---- */
.theme-dark .trip-tabs {
  background: #111318;
}

.theme-dark .trip-tab {
  color: var(--color-text-muted);
}

.theme-dark .trip-tab.active {
  background: var(--color-brand);
  color: var(--color-text-inverse);
}

/* ---- SVG Icon Images ---- */
.act-icon-sm {
  width: 22rpx;
  height: 22rpx;
  display: inline-block;
  vertical-align: middle;
}
