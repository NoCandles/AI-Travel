/* ========================================
   酒店列表页 — 所有 Token 由 variables.wxss 统一提供
   ======================================== */

/* ---- 页面容器 ---- */
.page {
  position: relative;
  overflow: hidden;
  background: var(--color-bg);
  min-height: 100vh;
  padding: 0 var(--space-page-x);
}

/* ---- 深色模式页面背景（强制覆盖，规避跨页面 CSS 变量级联不可靠） ---- */
.theme-dark.page,
.page.theme-dark {
  background: #111318;
  color: var(--color-text);
}

/* ---- Header ---- */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.header-left {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  color: var(--color-dark);
  position: relative;
}

.header-title::after {
  content: "";
  position: absolute;
  bottom: -8rpx;
  left: 0;
  width: 72rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 4rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--color-muted);
  margin-top: 20rpx;
}

/* ---- 加载状态 ---- */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  position: relative;
  z-index: 1;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-muted);
}

/* ---- 错误状态 ---- */
.error-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  position: relative;
  z-index: 1;
}

.error-icon,
.empty-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.error-text,
.empty-text {
  font-size: 28rpx;
  color: var(--color-muted);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--color-placeholder);
  margin-bottom: 16rpx;
}

.btn-retry {
  margin-top: 16rpx;
  padding: 16rpx 48rpx;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  border: none;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.btn-retry::after {
  border: none;
}

/* ---- 板块 ---- */
.section {
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-muted);
}

.section-title .svg-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ---- 卡片列表 ---- */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ---- 酒店卡片 ---- */
.hotel-card {
  background: transparent;
  border-radius: 0;
  padding: 24rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  box-shadow: none;
  border: none;
  border-bottom: 1rpx solid var(--color-divider);
  transition: border-color 0.2s;
  position: relative;
}
.hotel-card:last-child {
  border-bottom: none;
}

.hotel-card:active {
  transform: scale(0.99);
}

.hotel-card-selected {
  border-color: var(--color-primary);
  background: var(--color-success-bg);
}

.card-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.card-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-dark);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-loc {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  font-weight: 500;
}

.card-loc-icon {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

.card-meta-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
}

.card-distance,
.card-tel {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--color-muted);
  font-weight: 500;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
}

.card-tel:active {
  color: var(--color-primary);
}
.hotel-decision-hint {
  padding: 8rpx 10rpx;
  border-radius: 8rpx;
  background: var(--color-brand-10);
  color: var(--color-brand-deep);
  font-size: 22rpx;
  line-height: 1.45;
}

.card-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.tag {
  background: var(--color-surface-alt);
  color: var(--color-muted);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* ---- 右侧按钮 ---- */
.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.btn-map,
.btn-select {
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  min-width: 90rpx;
  text-align: center;
}

.btn-map {
  background: var(--color-surface);
  color: var(--color-dark);
  border: 2rpx solid var(--color-border);
}

.btn-select {
  background: var(--color-primary);
  color: var(--color-text-inverse);
  border: none;
}

.btn-selected {
  background: var(--color-brand-light);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  box-shadow: none;
}

.btn-map::after,
.btn-select::after {
  border: none;
}

/* ---- 加载更多 ---- */
.load-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: var(--color-placeholder);
  position: relative;
  z-index: 1;
}

/* ---- 底部安全区 ---- */
.safe-bottom {
  height: 48rpx;
}

/* ======== 暗色主题（仅页面特有覆盖） ======== */
.theme-dark .hotel-card {
  background: transparent;
  border: none;
  border-bottom-color: var(--color-divider);
}

.theme-dark .hotel-card-selected {
  border-color: transparent;
  background: transparent;
}

.theme-dark .tag {
  background: #22252d;
}

.theme-dark .btn-map {
  background: #1a1d24;
  border-color: #2a2d35;
  color: #e4e6eb;
}
