/* ========================================
   我的发布 — 所有 Token 由 variables.wxss 统一提供
   ======================================== */

.page {
  padding: 0 var(--space-page-x);
  min-height: 100vh;
  background: var(--color-surface-alt);
  box-sizing: border-box;
}

/* ---- 深色模式页面背景（强制覆盖，规避跨页面 CSS 变量级联不可靠） ---- */
.theme-dark.page,
.page.theme-dark {
  background: #111318;
  color: var(--color-text);
}

.header {
  padding: 32rpx 0 20rpx;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-dark);
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.publish-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.publish-card {
  display: flex;
  background: var(--color-surface);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  position: relative;
}

.publish-cover {
  width: 200rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.publish-body {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.publish-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-dark);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.publish-meta {
  display: flex;
  gap: 16rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.publish-stat {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.publish-stat image {
  width: 22rpx;
  height: 22rpx;
}

.publish-time {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.publish-actions {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  z-index: 2;
}

.publish-delete {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-danger-bg);
  color: var(--color-danger);
  border: none;
  line-height: 1.6;
  margin: 0;
}

.publish-edit {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--color-brand-light);
  color: var(--color-brand-deep);
  border: none;
  line-height: 1.6;
  margin: 0;
}

.publish-edit::after {
  border: none;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-icon-img {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
  opacity: .82;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 暗色模式（仅页面特有覆盖） */
.theme-dark .publish-card {
  background: var(--color-surface);
}
