.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: var(--color-text);
  display: flex;
  flex-direction: column;
}

.theme-dark.page,
.page.theme-dark {
  background: #111318;
}

.chat-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx var(--space-page-x);
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-divider);
}

.header-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--color-surface-alt);
}

.header-main {
  flex: 1;
  min-width: 0;
}

.header-name,
.header-desc {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-name {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.header-desc {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.message-scroll {
  flex: 1;
  height: calc(100vh - 230rpx - env(safe-area-inset-bottom));
  min-height: 0;
}

.message-list {
  padding: 24rpx var(--space-page-x) 32rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.message-row.mine {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-surface-alt);
}

.message-bubble {
  max-width: 520rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: var(--color-surface);
  box-shadow: var(--card-shadow);
  box-sizing: border-box;
}

.message-row.mine .message-bubble {
  background: var(--color-brand);
  color: var(--color-text-inverse);
}

.message-text {
  font-size: 28rpx;
  line-height: 42rpx;
  word-break: break-word;
}

.message-bubble.route {
  padding: 0;
  overflow: hidden;
  background: var(--color-surface);
}

.route-card {
  width: 500rpx;
  background: var(--color-surface);
}

.route-cover {
  width: 100%;
  height: 180rpx;
  display: block;
  background: var(--color-surface-alt);
}

.route-info {
  padding: 18rpx;
}

.route-label {
  display: block;
  color: var(--color-brand);
  font-size: 22rpx;
  font-weight: 700;
}

.route-title {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 38rpx;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.route-action {
  display: block;
  margin-top: 12rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  opacity: .72;
}

.empty-title {
  color: var(--color-text);
  font-size: 30rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 24rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx var(--space-page-x) calc(18rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-divider);
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: var(--color-surface-alt);
  color: var(--color-text);
  font-size: 26rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--color-muted);
}

.send-btn {
  width: 112rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 36rpx;
  background: var(--color-surface-alt);
  color: var(--color-muted);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.send-btn.active {
  background: var(--color-brand);
  color: var(--color-text-inverse);
}

.send-btn::after {
  border: none;
}

.theme-dark .chat-header,
.theme-dark .input-bar,
.theme-dark .message-bubble,
.theme-dark .route-card,
.theme-dark .message-bubble.route {
  background: var(--color-surface);
}
