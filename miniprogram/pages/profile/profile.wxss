/* 拾路派 - 个人主页，所有主题色来自 styles/variables.wxss */
.page {
  position: relative;
  min-height: 100vh;
  background: var(--color-bg);
  box-sizing: border-box;
}

.theme-dark.page,
.page.theme-dark {
  background: #111318;
  color: var(--color-text);
}

.profile-header {
  position: relative;
  width: 100%;
}

.cover-area {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}

.cover-default {
  background: linear-gradient(135deg, #b8ece6 0%, #d4f0ec 44%, #e8f6f4 100%);
}

.theme-dark .cover-default {
  background: linear-gradient(135deg, #1f6d66 0%, #2a867c 48%, #36464b 100%);
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.38));
}

.cover-settings-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 3;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-settings-icon {
  width: 32rpx;
  height: 32rpx;
}

.profile-info {
  position: relative;
  z-index: 2;
  margin-top: -200rpx;
  padding: 0 var(--space-page-x);
}

.profile-top-row {
  display: flex;
  align-items: flex-end;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.avatar-wrap,
.avatar-img {
  width: 140rpx;
  height: 140rpx;
}

.avatar-wrap {
  flex-shrink: 0;
}

.avatar-img {
  border-radius: 50%;
  border: 4rpx solid #fff;
  background: var(--color-brand-light);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.profile-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-bottom: 8rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profile-name {
  flex: 1;
  min-width: 0;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.btn-edit-profile {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.profile-id,
.signature-text,
.profile-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.signature-text {
  display: block;
  max-width: 100%;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.profile-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.tag-icon {
  width: 20rpx;
  height: 20rpx;
}

.gender-male,
.gender-female {
  font-weight: 600;
}

.gender-female {
  color: #e8458b;
}

.profile-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-bottom: 24rpx;
  padding: 24rpx 0;
  border-radius: 20rpx;
  background: var(--color-surface);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.profile-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.profile-stat-num {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 800;
  color: var(--color-dark);
}

.profile-stat-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-muted);
}

.btn-login-cover {
  width: 100%;
  margin: 16rpx 0 24rpx;
  padding: 22rpx;
  border: none;
  border-radius: 32rpx;
  background: var(--color-brand);
  color: var(--color-text-inverse);
  font-size: 28rpx;
  font-weight: 600;
}

.btn-login-cover::after,
.route-share::after {
  border: none;
}

.points-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 var(--space-page-x) 20rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: var(--color-primary);
  box-shadow: 0 4rpx 16rpx var(--color-brand-20);
  box-sizing: border-box;
}

.points-entry-left,
.points-entry-right {
  display: flex;
  align-items: center;
}

.points-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.points-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.points-entry-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.points-entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-inverse);
}

.points-entry-desc,
.arrow {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.points-num {
  margin-right: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.25);
  color: var(--color-text-inverse);
  font-size: 24rpx;
  font-weight: 600;
}

.arrow {
  font-size: 36rpx;
}

.content-shell {
  margin: 0 0 20rpx;
  background: var(--color-bg);
}

.content-tabs {
  position: sticky;
  top: 0;
  z-index: 8;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 52rpx;
  width: 100%;
  padding: 20rpx var(--space-page-x) 18rpx;
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
  box-sizing: border-box;
}

.content-tab {
  position: relative;
  padding: 8rpx 4rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-muted);
}

.content-tab.active {
  color: var(--color-dark);
}

.content-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-brand);
  transform: translateX(-50%);
}

.route-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  grid-auto-rows: auto;
  gap: 16rpx;
  padding: 20rpx var(--space-page-x) 8rpx;
  min-height: 620rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.route-card {
  min-width: 0;
  overflow: hidden;
  align-self: start;
  border-radius: 16rpx;
  background: var(--color-surface);
  box-shadow: var(--card-shadow);
  display: flex;
  flex-direction: column;
}

.route-cover {
  width: 100%;
  height: 156rpx;
  display: block;
  background: var(--color-surface-alt);
}

.route-body {
  padding: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.route-title {
  display: block;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 700;
  color: var(--color-dark);
  overflow: hidden;
  text-overflow: ellipsis;
  max-height: 64rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.route-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-meta-icon {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
  display: block;
}

.route-meta text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  min-height: 40rpx;
}

.route-author {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-avatar {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: block;
}

.route-author text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-share {
  flex-shrink: 0;
  margin: 0;
  padding: 0 14rpx;
  min-height: 0;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 20rpx;
  background: var(--color-brand-light);
  color: var(--color-brand);
  font-size: 20rpx;
  font-weight: 700;
}

.visited-panel {
  padding: 20rpx var(--space-page-x) 8rpx;
  min-height: 620rpx;
  background: var(--color-bg);
  box-sizing: border-box;
}

.visited-summary {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--color-brand), #1ea88e);
  box-shadow: 0 8rpx 24rpx var(--color-brand-30);
}

.visited-summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.visited-num {
  font-size: 46rpx;
  line-height: 1;
  font-weight: 800;
  color: #fff;
}

.visited-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.visited-divider {
  width: 2rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.28);
}

.visited-map-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--color-surface);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.visited-map {
  width: 100%;
  height: 720rpx;
}

.visited-map-legend {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 24rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.legend-area {
  width: 28rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: #2EC4B670;
  border: 2rpx solid #2EC4B6CC;
  flex-shrink: 0;
}

.profile-empty {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 40rpx;
  text-align: center;
}

.profile-empty-icon {
  width: 84rpx;
  height: 84rpx;
  margin-bottom: 20rpx;
  opacity: 0.74;
}

.profile-empty-title {
  margin-bottom: 10rpx;
  color: var(--color-dark);
  font-size: 30rpx;
  font-weight: 700;
}

.profile-empty-desc,
.content-loading {
  color: var(--color-muted);
  font-size: 24rpx;
}

.content-loading {
  padding: 24rpx var(--space-page-x) 36rpx;
  text-align: center;
}

.card {
  margin: 0 var(--space-page-x) 20rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-surface);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.card-header-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-header-icon.pref {
  background: var(--color-info-bg);
}

.card-header-img {
  width: 24rpx;
  height: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-dark);
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.setting-item.last {
  border-bottom: none;
  padding-bottom: 0;
}

.setting-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.setting-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.setting-icon.blue { background: var(--color-info-bg); }
.setting-icon.orange { background: var(--color-accent-light); }
.setting-icon.green { background: var(--color-brand-light); }

.settings-item-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
  margin: 16rpx;
}

.setting-info {
  flex: 1;
  min-width: 0;
}

.setting-text {
  display: block;
  color: var(--color-dark);
  font-size: 28rpx;
  font-weight: 600;
}

.setting-desc {
  display: block;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.picker-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: var(--color-brand-light);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.theme-dark .cover-overlay {
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.58));
}

.theme-dark .avatar-img {
  border-color: #1a1d24;
}

.theme-dark .profile-stats,
.theme-dark .card,
.theme-dark .route-card,
.theme-dark .visited-map-card {
  background: var(--color-surface);
  border: var(--card-border);
}

.theme-dark .content-tabs {
  background: var(--color-surface);
  border-bottom-color: var(--color-divider);
}

.theme-dark .content-shell,
.theme-dark .route-grid,
.theme-dark .visited-panel {
  background: #111318;
}

.theme-dark .content-tab.active,
.theme-dark .profile-stat-num,
.theme-dark .card-title,
.theme-dark .setting-text,
.theme-dark .route-title,
.theme-dark .profile-empty-title {
  color: var(--color-text);
}

.theme-dark .profile-stat-label,
.theme-dark .points-entry-desc,
.theme-dark .route-meta,
.theme-dark .route-author,
.theme-dark .setting-desc,
.theme-dark .profile-empty-desc,
.theme-dark .content-loading,
.theme-dark .visited-map-legend {
  color: var(--color-text-muted);
}

.theme-dark .content-tab {
  color: var(--color-text-muted);
}

.theme-dark .setting-item {
  border-bottom-color: var(--color-divider);
}

.theme-dark .route-cover {
  background: var(--color-surface-input);
}
