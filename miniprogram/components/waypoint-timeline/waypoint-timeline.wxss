/* 途经点时间线组件 */
.wp-list {
  padding: 0 0 20rpx 0;
}

.wp-item {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding: 16rpx 30rpx 16rpx 80rpx;
  min-height: 80rpx;
}

/* 左侧圆点 */
.wp-dot {
  position: absolute;
  left: 30rpx;
  top: 20rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-text-inverse);
  z-index: 2;
}

.dot-start {
  background: #52c41a;
}

.dot-end {
  background: #f5222d;
}

.dot-normal {
  background: #3A7BD5;
}

/* 中间的连线 */
.wp-line {
  position: absolute;
  left: 48rpx;
  top: 60rpx;
  width: 4rpx;
  height: calc(100% - 40rpx);
  background: #e8ecf1;
  z-index: 1;
}

/* 内容 */
.wp-content {
  flex: 1;
  min-width: 0;
}

.wp-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C2A3A;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wp-meta {
  font-size: 22rpx;
  color: #8B8FA3;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wp-time,
.wp-duration,
.wp-end-label,
.wp-addr {
  display: inline;
}

/* 编辑模式按钮 */
.wp-actions {
  display: flex;
  gap: 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.wp-drag-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid #ddd;
  background: #f5f6f8;
  color: #666;
}

.wp-drag-btn.del {
  color: #FF6B6B;
  border-color: #FFD5D5;
  background: #FFF5F5;
}

/* 空状态 */
.wp-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
}

/* 暗黑模式 */
.theme-dark .wp-name {
  color: #e4e6eb;
}

.theme-dark .wp-line {
  background: #2a2d35;
}

.theme-dark .wp-drag-btn {
  background: #22252d;
  border-color: #333;
  color: #999;
}

.theme-dark .wp-drag-btn.del {
  background: #2d2222;
  border-color: #442222;
  color: #FF6B6B;
}
