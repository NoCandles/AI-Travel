/* 路线统计卡片组件样式 */
.stats-card {
  position: absolute;
  left: 20rpx;
  top: 110rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  background: rgba(255,255,255,0.92);
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  box-shadow:
    0 2rpx 6rpx rgba(0,0,0,0.06),
    0 4rpx 14rpx rgba(0,0,0,0.04),
    inset 0 1rpx 0 rgba(255,255,255,0.8);
  z-index: 10;
  border: 1rpx solid rgba(255,255,255,0.5);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 16rpx;
  border-right: 1rpx solid rgba(0,0,0,0.06);
}

.stat-item:last-child {
  border-right: none;
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-val {
  font-size: 24rpx;
  font-weight: 600;
  color: #1C2A3A;
  line-height: 1.3;
}

.stat-lbl {
  font-size: 18rpx;
  color: #8B8FA3;
  line-height: 1.3;
}

/* 多路线切换按钮 */
.path-switcher {
  margin-left: 8rpx;
}

.switch-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #2EC4B6;
  border-radius: 20rpx;
}

.switch-icon {
  width: 24rpx;
  height: 24rpx;
}

.switch-label {
  font-size: 20rpx;
  color: var(--color-text-inverse);
  font-weight: 500;
}

/* 暗黑模式 */
.theme-dark .stats-card {
  background: rgba(37, 40, 48, 0.95);
  border: 1rpx solid rgba(255,255,255,0.03);
}

.theme-dark .stat-val {
  color: #e4e6eb;
}

.theme-dark .stat-lbl {
  color: #8B8FA3;
}

.theme-dark .stat-item {
  border-right-color: rgba(255,255,255,0.08);
}
