/* 路线方案选择器 */
.picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.picker-content {
  width: 100%;
  background: var(--color-surface);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 30rpx;
  box-sizing: border-box;
  max-height: 60vh;
  overflow-y: auto;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C2A3A;
  margin-bottom: 24rpx;
  text-align: center;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  background: #F0F3F9;
  border: 2rpx solid transparent;
}

.picker-active {
  border-color: #2EC4B6;
  background: #F0FFFE;
}

.picker-item-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1C2A3A;
  flex: 1;
}

.picker-item-meta {
  font-size: 24rpx;
  color: #8B8FA3;
  margin-right: 16rpx;
}

.picker-item-check {
  width: 32rpx;
  height: 32rpx;
}

/* 暗黑模式 */
.theme-dark .picker-content {
  background: #1a1d26;
}

.theme-dark .picker-title {
  color: #e4e6eb;
}

.theme-dark .picker-item {
  background: #22252d;
}

.theme-dark .picker-active {
  border-color: #2EC4B6;
  background: #1a2d2a;
}

.theme-dark .picker-item-label {
  color: #e4e6eb;
}
