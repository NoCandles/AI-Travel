<!--
  通用状态模板：loading / error / empty
  页面引入方式：
    <import src="/templates/state-template.wxml"/>
    <template is="state-view" data="{{loading, error, empty, emptyText, onRetry}}"/>
-->
<template name="state-view">
  <!-- 加载中 -->
  <view class="state-wrap" wx:if="{{loading}}">
    <view class="state-spinner"></view>
    <text class="state-text">加载中...</text>
  </view>

  <!-- 加载失败 -->
  <view class="state-wrap" wx:elif="{{error}}">
    <image class="state-icon-img" src="/images/icons/help.svg" mode="aspectFit" />
    <text class="state-text">加载失败</text>
    <button class="state-btn" bindtap="retry" wx:if="{{onRetry}}">点击重试</button>
  </view>

  <!-- 空数据 -->
  <view class="state-wrap" wx:elif="{{empty}}">
    <image class="state-icon-img" src="/images/icons/clipboard-list.svg" mode="aspectFit" />
    <text class="state-text">{{emptyText || '暂无数据'}}</text>
  </view>
</template>
